# Porta em que a API vai rodar
PORT=3555

# Ambiente
NODE_ENV=development

# String de conexão PostgreSQL (obrigatória).
# Local (docker-compose): postgres://postgres:postgres@localhost:5432/devshowcase
# Produção (Supabase / Render PostgreSQL): connection string fornecida pelo provedor.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/devshowcase

# Exige SSL na conexão com o banco. Deixe "true" em produção (Supabase/Render exigem SSL).
DB_SSL=false
