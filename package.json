{
  "name": "devshowcase-api",
  "version": "1.0.0",
  "description": "DevShowcase API - plataforma para desenvolvedores exibirem perfis, projetos, tecnologias e receberem feedback.",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "db:reset": "node -e \"require('./src/models').sequelize.sync({ force: true }).then(() => process.exit(0))\"",
    "test": "jest --runInBand",
    "demo": "node scripts/demo.js"
  },
  "keywords": [
    "express",
    "sequelize",
    "rest-api",
    "devshowcase"
  ],
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "helmet": "^8.3.0",
    "joi": "^17.13.3",
    "morgan": "^1.10.0",
    "pg": "^8.13.1",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.3",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "jest": "^30.5.1",
    "nodemon": "^3.1.4",
    "supertest": "^7.2.2"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "nodemonConfig": {
    "ignore": []
  },
  "jest": {
    "testEnvironment": "node",
    "setupFiles": [
      "<rootDir>/tests/setup/env.js"
    ]
  }
}
